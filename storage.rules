rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /reports/{allPaths=**} {
      allow read: if true;
      // create = foto pertama untuk kedai ini; update = kedai yang sama upload ulang
      // di path yang sama (path tanpa timestamp, jadi otomatis menimpa file lama).
      allow create, update: if
        request.resource.size < 8 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }
  }
}
