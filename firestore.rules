rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /reports/{reportId} {
      allow read: if true;
      // create = kedai baru pertama kali submit; update = kedai yang sama upload
      // ulang (menimpa laporan sebelumnya, ID dokumennya sengaja dibuat tetap
      // per area+mds+kedai di tuset.html). Delete tetap ditutup dari client.
      allow create, update: if
        request.resource.data.keys().hasAll(['area', 'mds', 'kedai', 'foto_ktp', 'foto_penyerahan', 'created_at']) &&
        request.resource.data.area is string &&
        request.resource.data.mds is string &&
        request.resource.data.kedai is string &&
        request.resource.data.foto_ktp is string &&
        request.resource.data.foto_penyerahan is string;
      allow delete: if false;
    }
  }
}
