rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // reports (app tuset.html) — foto boleh diupload satu-satu (merge:true),
    // jadi foto_ktp/foto_penyerahan/foto_display cuma divalidasi KALAU ada.
    match /reports/{reportId} {
      allow read: if true;
      allow create, update: if
        request.resource.data.keys().hasAll(['area', 'mds', 'kedai', 'created_at']) &&
        request.resource.data.area is string &&
        request.resource.data.mds is string &&
        request.resource.data.kedai is string &&
        (!('foto_ktp' in request.resource.data) || request.resource.data.foto_ktp is string) &&
        (!('foto_penyerahan' in request.resource.data) || request.resource.data.foto_penyerahan is string) &&
        (!('foto_display' in request.resource.data) || request.resource.data.foto_display is string);
      allow delete: if false;
    }

    // report_status (halaman status.html) — salinan RINGAN dari reports, cuma
    // boolean status foto (tanpa base64), supaya halaman status bisa dengerin
    // seluruh collection tanpa memuat foto sama sekali.
    match /report_status/{reportId} {
      allow read: if true;
      allow create, update: if
        request.resource.data.keys().hasAll(['area', 'mds', 'kedai']) &&
        request.resource.data.area is string &&
        request.resource.data.mds is string &&
        request.resource.data.kedai is string &&
        (!('ktp' in request.resource.data) || request.resource.data.ktp is bool) &&
        (!('peny' in request.resource.data) || request.resource.data.peny is bool) &&
        (!('disp' in request.resource.data) || request.resource.data.disp is bool);
      allow delete: if false;
    }

    // Semua collection lain (tidak pakai Firebase Auth) — dibuka penuh
    // termasuk seluruh sub-collection di dalamnya.
    match /distributor_reg/{document=**} { allow read, write: if true; }
    match /focusData/{document=**} { allow read, write: if true; }
    match /indogrosir_data/{document=**} { allow read, write: if true; }
    match /insentifData/{document=**} { allow read, write: if true; }
    match /kedai_db/{document=**} { allow read, write: if true; }
    match /monitoring_noo/{document=**} { allow read, write: if true; }
    match /pjmds_data/{document=**} { allow read, write: if true; }
    match /pjmds_manual_match/{document=**} { allow read, write: if true; }
    match /sulawesi_db_kedai/{document=**} { allow read, write: if true; }
    match /sulawesi_mds_data/{document=**} { allow read, write: if true; }
    match /tokoMTTargets/{document=**} { allow read, write: if true; }
    match /tokomodern_data/{document=**} { allow read, write: if true; }
    match /tracker_expenses/{document=**} { allow read, write: if true; }
    match /tracker_debts/{document=**} { allow read, write: if true; }
  }
}
